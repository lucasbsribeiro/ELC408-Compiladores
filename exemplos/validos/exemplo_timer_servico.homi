entidades {
  timer cafe = timer.cafe_manha;
  alarme casa = alarm_control_panel.alarmo;
  midia tv = media_player.music_frame;
}

automacao "Lembrete - cafe" {
  quando hora 07:30;
  se casa esta disarmed;
  entao timer cafe iniciar; servico media_player.play_media(entity_id=media_player.music_frame, media_content_id="spotify:track:123", media_content_type="music"); notificar "Bom dia";
  modo single;
}
